# Copy to .env and adjust paths. .env itself is gitignored.

# Postgres published by docker-compose. Port 5440 rather than 5432/5433/5434 to
# avoid colliding with other local stacks -- a collision shows up as
# "password authentication failed", not as a port error.
DATABASE_URL=postgresql://radonc:radonc@localhost:5440/radonc

# Hugging Face and pip both default to the system drive. MedCPT is ~880 MB across
# its two encoders and a CUDA torch wheel is ~2.5 GB, so point them somewhere with
# room. Leaving these unset produces a disk-full error that reads like a network
# failure.
HF_HOME=/path/to/project/.cache/huggingface
PIP_CACHE_DIR=/path/to/project/.cache/pip
